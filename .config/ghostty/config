# --- Tipografía ---
font-family = "JetBrainsMono Nerd Font"
font-size = 11


#Paleta generada por matugen
theme = tema_matugen

# --- Ventana y Estética ---
background-opacity = 0.9
background-blur = true
window-decoration = false

window-padding-x = 15
window-padding-y = 15

# --- Portapapeles (Seleccionar para copiar y Ctrl+V para pegar) ---
copy-on-select = true
keybind = ctrl+v=paste_from_clipboard

