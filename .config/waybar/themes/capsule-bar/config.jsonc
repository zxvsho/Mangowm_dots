{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 10,

  "modules-left": ["ext/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "tray",
    "bluetooth",
    "network",
    "pulseaudio",
    "backlight",
    "cpu",
    "battery",
    "custom/power"
  ],

  "ext/workspaces": {
    "format": "{icon}",
    "ignore-hidden": true,
    "on-click": "mmsg dispatch workspace {index}",
    "on-click-right": "mmsg dispatch workspace {index}",
    "on-scroll-up": "mmsg dispatch workspace +1",
    "on-scroll-down": "mmsg dispatch workspace -1"
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%A, %B %d}",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month",
      "mode-monitor": "month-year",
      "format": {
        "months":   "<span color='#cdd6f4'><b>{}</b></span>",
        "days":     "<span color='#cdd6f4'>{}</span>",
        "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
        "today":    "<span color='#f38ba8'><b>{}</b></span>"
      }
    },
    "on-click-right": "foot --app-id=foot-peaclock -e peaclock"
  },

  "cpu": {
    "format": "󰻠 {usage}%",
    "interval": 2,
    "on-click": "foot --app-id=foot-btop -e btop"
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format": "{ifname}: {ipaddr}",
    "interval": 3,
    "on-click": "foot --app-id=foot-impala -e impala"
  },

  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}",
    "on-click": "foot --app-id=foot-bluetui -e bluetui"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "on-click": "foot --app-id=foot-wiremix -e wiremix"
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"]
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": { "warning": 20, "critical": 10 },
    "on-click": "foot --app-id=foot-bluetui -e bluetui"
  },

  "tray": {
    "spacing": 10,
    "icon-size": 18
  },

  "custom/power": {
    "format": "󰐥",
    "on-click": "wlogout",
    "tooltip": false
  }
}
