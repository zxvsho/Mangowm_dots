{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ascii_fastfetch.txt",
    "padding": {
      "top": 3,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "╭─────────── Información ───────────╮"
    },
    {
      "type": "os",
      "key": "│   OS     ",
      "format": "{pretty-name>22} │"
    },
    {
      "type": "kernel",
      "key": "│   Kernel ",
      "format": "{release>22} │"
    },
    {
      "type": "uptime",
      "key": "│   Uptime ",
      "format": "           {pretty>22} │"
    },
    {
      "type": "packages",
      "key": "│   Pkgs   ",
      "format": "{all>22} │"
    },
    {
      "type": "shell",
      "key": "│   Shell  ",
      "format": "{pretty-name>22} │"
    },
    {
      "type": "wm",
      "key": "│   WM     ",
      "format": "{pretty-name>22} │"
    },
    {
      "type": "custom",
      "format": "├───────────────────────────────────┤"
    },
    {
      "type": "cpu",
      "key": "│   CPU    ",
      "format": "{name>22} │"
    },
    {
      "type": "memory",
      "key": "│   Mem                 ",
      "format": "{used}  │"
    },
    {
      "type": "custom",
      "format": "╰───────────────────────────────────╯"
    },
    "break",
    "colors"
  ]
}
